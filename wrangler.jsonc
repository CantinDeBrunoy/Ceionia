{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  // Le build Vite du jeu, servi tel quel par Cloudflare Workers : https://ceionia.cantin-roquier.workers.dev
  // Un petit Worker (worker/index.ts) ne répond qu'à la mesure d'audience (/api/ping) et au back-office (/bo) :
  // tout le reste va droit aux fichiers statiques, sans passer par lui (voir docs/mesure-audience.md)
  "name": "ceionia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bo", "/bo/*"]
  },
  // La base D1 de la mesure d'audience (créée le 26 nov. 2026, région Europe de l'Ouest ; voir docs/mesure-audience.md)
  "d1_databases": [{ "binding": "DB", "database_name": "ceionia-audience", "database_id": "1f09deaa-664d-4aef-b62d-998d1d65d286", "migrations_dir": "migrations" }],
  // Les limiteurs comptent en mémoire chez Cloudflare, rien n'est écrit : par joueur (identifiant tiré au hasard),
  // par adresse IP (jamais enregistrée), et les essais de connexion au back-office
  "ratelimits": [
    { "name": "PING_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "PING_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "BO_LOGIN", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // chaque nuit, l'effacement des données de plus de 13 mois
  "triggers": { "crons": ["17 3 * * *"] },
  "env": {
    // Essai en local seulement (`wrangler dev --env essai`), jamais déployé : la même chose, avec une base locale
    "essai": {
      "d1_databases": [
        { "binding": "DB", "database_name": "ceionia-audience", "database_id": "essai-local", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "PING_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "PING_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "BO_LOGIN", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
